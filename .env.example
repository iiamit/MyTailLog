# ---------------------------------------------------------------------------
# MyTailLog environment configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# On Vercel, set these same keys in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API) — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Vision-LLM for handwritten extraction. This is the one line item that costs
# money — bring your own key. Without it the app runs but extraction is disabled.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: model for VISION / handwriting extraction (reads page images).
# Defaults to claude-opus-4-8 (best at messy handwriting). Keep this strong.
EXTRACTION_MODEL=claude-opus-4-8

# Optional: model for TEXT-only tasks (Ask-your-logbook Q&A, equipment &
# maintenance detection over already-extracted text). Defaults to the cheapest
# capable model. Set claude-sonnet-5 if Haiku's accuracy on equipment
# correlation disappoints. (Haiku 4.5 supports json_schema output but not
# adaptive thinking/effort — the code gates those automatically.)
TEXT_MODEL=claude-haiku-4-5

# Optional: storage bucket for logbook page images. Defaults to "logbook-pages".
# If you set one, set BOTH so server and browser agree.
LOGBOOK_STORAGE_BUCKET=logbook-pages
NEXT_PUBLIC_LOGBOOK_STORAGE_BUCKET=logbook-pages

# Note: no service-role key is needed. All DB/storage access runs under the
# signed-in user's session and is enforced by row-level security.
