# ---------------------------------------------------------------------------
# MyTailLog environment configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# On Vercel, set these same keys in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API) — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Vision-LLM for handwritten extraction. This is the one line item that costs
# money — bring your own key. Without it the app runs but extraction is disabled.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: model for VISION / handwriting extraction (reads page images).
# Defaults to claude-opus-4-8 (best at messy handwriting). Keep this strong.
EXTRACTION_MODEL=claude-opus-4-8

# Optional: model for TEXT-only tasks (Ask-your-logbook Q&A, equipment &
# maintenance detection over already-extracted text). Defaults to the cheapest
# capable model. Set claude-sonnet-5 if Haiku's accuracy on equipment
# correlation disappoints. (Haiku 4.5 supports json_schema output but not
# adaptive thinking/effort — the code gates those automatically.)
TEXT_MODEL=claude-haiku-4-5

# Optional: storage bucket for logbook page images. Defaults to "logbook-pages".
# If you set one, set BOTH so server and browser agree.
LOGBOOK_STORAGE_BUCKET=logbook-pages
NEXT_PUBLIC_LOGBOOK_STORAGE_BUCKET=logbook-pages

# Secret encryption key — REQUIRED once you use MyFlightBook or bring-your-own
# Anthropic key. Any non-empty string (SHA-256'd to a 32-byte AES-256-GCM key).
#   openssl rand -base64 32
# Rotating it makes existing encrypted secrets undecryptable. If local dev shares
# the SAME Supabase database as prod, use the SAME value in both.
ENCRYPTION_KEY=your-random-encryption-key

# Optional: RS256 signing keys (a JWKS JSON) for the OAuth Authorization Server.
# REQUIRED only if you expose the OAuth API (/api/oidc, /api/v1, /developers).
# Generate once and keep stable (rotating invalidates issued tokens):
#   node scripts/gen-oidc-jwks.mjs
# Without it, /api/oidc/* returns 503; the rest of the app is unaffected.
OIDC_JWKS=

# Optional: canonical public origin. Pins redirects / the OAuth redirect_uri
# instead of trusting the request Host header. Set in prod (e.g. https://mytaillog.com).
NEXT_PUBLIC_SITE_URL=

# Optional: AI usage caps on the shared ANTHROPIC_API_KEY. Per-user daily call
# caps (shared key vs a user's own key) and a global daily-$ ceiling on the
# shared key across all users (0 disables). Defaults shown.
AI_SHARED_USER_DAILY_CALLS=100
AI_OWN_USER_DAILY_CALLS=1000
AI_SHARED_DAILY_USD=20

# ---------------------------------------------------------------------------
# Server-only secret key (BYPASSES row-level security — never prefix NEXT_PUBLIC).
# Used by the daily cron AND by the AI usage ledger write (the cost-control
# metering); set it if you want the caps enforced or run the scheduled job.
# ---------------------------------------------------------------------------

# Supabase SECRET API key (format sb_secret_...). Create it in Supabase →
# Project Settings → API Keys → "Create secret key" (the recommended,
# individually-revocable replacement for the legacy service_role key). Used
# server-side to (a) read/write across users in the daily cron, and (b) write the
# ai_usage ledger so the shared-key cost guard can't be client-forged.
SUPABASE_SECRET_KEY=sb_secret_your-supabase-secret-key

# Resend API key for outbound reminder emails (https://resend.com → API Keys).
# Sender is "MyTailLog <noreply@mytaillog.com>" — verify that domain in Resend.
RESEND_API_KEY=re_your-resend-api-key

# Shared secret gating the cron endpoint. Generate a long random string, e.g.
#   openssl rand -hex 32
# Cloud Scheduler must send it as: Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=your-long-random-cron-secret
