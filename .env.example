# ---------------------------------------------------------------------------
# MyTailLog environment configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Used by the OCR/extraction pipeline to write
# extracted entries. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vision-LLM for handwritten extraction (Phase 1, step 4). This is the one
# line item that costs money — bring your own key. See README "Costs".
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override the storage bucket name for logbook page uploads.
LOGBOOK_STORAGE_BUCKET=logbook-pages
