  "narrative": {
    "northStar": "The Tabbed Binder",
    "overview": "MyTailLog looks like the records binder an owner already keeps: a dark cover rail with six coloured section tabs, a board flooded with the open section's colour, and white leaves laid on it, the record on the left and its scanned page on a dark mat on the right. A line map of the aircraft's life, drawn in printer's inks on a leaf, gives every record a place in time. Libre Franklin is the app speaking; Literata is only the logbook's own words. Status is ink plus one vermilion alarm.",
    "keyCharacteristics": [
      "Four grounds: cover, board, leaf, mat.",
      "Section hues fill boards and tabs only.",
      "Status is ink and vermilion, mark plus word; no green or amber.",
      "Two voices: Libre Franklin and Literata; tabular figures, no monospace.",
      "16px body, nothing under 13px, 4.5:1 contrast.",
      "Flat: the 1px leaf edge is the only shadow."
    ],
    "rules": [
      {
        "name": "The Ink and Vermilion Rule",
        "body": "Status is a filled ink dot (current), vermilion ring (due soon), solid vermilion slip (overdue) or dashed ring (no record), always with its word.",
        "section": "colors"
      },
      {
        "name": "The Board Rule",
        "body": "Section hues fill boards and tabs; on a leaf use section-ink.",
        "section": "colors"
      },
      {
        "name": "The Line Ink Rule",
        "body": "Logbook inks belong to the map and its keys, never status or sections.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Software text is Libre Franklin; transcribed text is Literata.",
        "section": "typography"
      },
      {
        "name": "The 13px Floor",
        "body": "No text below 13px except the listed 12px map and badge cases.",
        "section": "typography"
      },
      {
        "name": "The Paper Stack Rule",
        "body": "Leaves lie flat on the board; no card shadows or hover lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do generate values from tokens.json.",
      "Do show status as mark plus word.",
      "Do keep the source page one step away.",
      "Do keep one primary button per view.",
      "Do use tabular figures for numbers.",
      "Do default the theme to Match system."
    ],
    "donts": [
      "Don't use green or amber.",
      "Don't put a raw section hue on a leaf or draw the map on a board.",
      "Don't mix the two voices.",
      "Don't use monospace, a third typeface or emoji icons.",
      "Don't add card shadows, glows or gradients.",
      "Don't let unconfirmed readings move anything.",
      "Don't write airworthy, legal to fly, grounded or compliant."
    ]
  }
}