    "text": "Every aircraft has a story."
  },
  {
    "start": 2.0149999999999997,
    "end": 4.476,
    "text": "But on paper, that story lives in separate logbooks."
  },
  {
    "start": 8.285,
    "end": 8.865,
    "text": "Airframe."
  },
  {
    "start": 9.724,
    "end": 10.177,
    "text": "Engine."
  },
  {
    "start": 10.943999999999999,
    "end": 11.582,
    "text": "Propeller."
  },
  {
    "start": 12.347999999999999,
    "end": 13.358,
    "text": "Avionics."
  },
  {
    "start": 16.273,
    "end": 16.9,
    "text": "Different dates."
  },
  {
    "start": 16.9,
    "end": 17.783,
    "text": "Different tasks."
  },
  {
    "start": 17.783,
    "end": 20.987000000000002,
    "text": "Maintenance, inspections, and AD tracking."
  },
  {
    "start": 20.987000000000002,
    "end": 22.287,
    "text": "A lot to keep connected."
  },
  {
    "start": 24.308,
    "end": 26.502,
    "text": "MyTailLog brings it all together."
  },
  {
    "start": 26.502,
    "end": 28.743000000000002,
    "text": "Turn scattered pages into a connected view of your"
  },
  {
    "start": 28.743000000000002,
    "end": 29.591,
    "text": "aircraft."
  },
  {
    "start": 32.308,
    "end": 35.234,
    "text": "Scan or upload your logbooks, then review the extracted"
  },
  {
    "start": 35.234,
    "end": 37.08,
    "text": "entries right beside the originals."
  },
  {
    "start": 39.296,
    "end": 41.305,
    "text": "Follow the history across every book."
  },
  {
    "start": 41.305,
    "end": 43.569,
    "text": "See what's due, and plan what comes next."
  },
  {
    "start": 46.296,
    "end": 48.758,
    "text": "Track hours, oil, and squawks."
  },
  {
    "start": 48.758,
    "end": 50.673,
    "text": "Connect MyFlightBook to help keep your records"
  },
  {
    "start": 50.673,
