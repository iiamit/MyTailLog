# Copy to apps/mobile/.env and fill in. Use the SAME values as the web app's
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY (the anon key is public).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Where the self-hosted sync API lives. Defaults to prod if unset.
VITE_API_BASE=https://mytaillog.com
