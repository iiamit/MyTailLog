{
  "name": "@mytaillog/mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "MyTailLog mobile app (Capacitor + Vite + React) — offline-first, self-hosted sync.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "cap:sync": "vite build && cap sync ios",
    "android:check": "npm run typecheck && npm run build && cap sync android && cd android && ./gradlew :app:assembleDebug --no-daemon --max-workers=1",
    "android:bundle": "./scripts/android-bundle.sh",
    "play:check": "node scripts/play.mjs check",
    "play:draft": "npm run android:bundle && node scripts/play.mjs draft",
    "play:internal": "node scripts/play.mjs internal",
    "play:closed": "node scripts/play.mjs closed",
    "ios": "vite build && cap sync ios && cap open ios",
    "testflight": "./scripts/testflight.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-document-scanner": "^8.4.2",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
