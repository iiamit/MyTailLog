{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    // Mirrors the Vite alias: `@/…` is apps/web/src, so the shared pure math is
    // typechecked here too rather than trusted. See vite.config.ts.
    "baseUrl": ".",
    "paths": { "@/*": ["../web/src/*"] }
  },
  "include": ["src"]
}
